.img-wrapper {
  display: block;
  width: 100%;
  max-width: 150px; /* puedes ajustar */
  aspect-ratio: 1 / 1;
  position: relative;
  overflow: hidden;
}

/* imágenes */
.img-wrapper img {
  position: absolute;
  width: 100%;
  height: 100%;

  top: 0;
  left: 0;
}

/* título encima de la imagen */
.caption-title {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  
  /* altura uniforme */
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;

  /* estilo visual */
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 14px;
  margin: 0;
  padding: 5px;

  text-align: center;
  line-height: 1.2;

  /* evita que textos largos rompan el diseño */
  overflow: hidden;
}

/* responsive ajuste */
@media (max-width: 768px) {
  .caption-title {
    height: 35px;
    font-size: 12px;
  }
}
/* Mostrar solo una imagen según dispositivo */
.desktop {
  display: block;
}

.mobile {
  display: none;
}

@media (max-width: 768px) {
  .desktop {
    display: none;
  }
  .mobile {
    display: block;
  }
}
